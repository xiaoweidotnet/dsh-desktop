{
  "name": "deepseek-harness-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "A cross-platform desktop launcher for DeepSeek Harness.",
  "license": "MIT",
  "author": "xiaoweidotnet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoweidotnet/dsh-desktop.git"
  },
  "homepage": "https://github.com/xiaoweidotnet/dsh-desktop#readme",
  "bugs": {
    "url": "https://github.com/xiaoweidotnet/dsh-desktop/issues"
  },
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron .",
    "verify": "node scripts/verify-project.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "test": "node --test test/*.test.mjs",
    "sync:harness": "node scripts/update-harness-runtime.mjs --apply",
    "check:harness": "node scripts/update-harness-runtime.mjs --check",
    "smoke:harness": "node scripts/harness-smoke.mjs",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "dist:dir": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "dist:dir:mac:x64": "electron-builder --config electron-builder.config.cjs --mac --x64 --dir --publish never",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:mac:x64": "electron-builder --config electron-builder.config.cjs --mac --x64 --publish never",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:win:arm64": "electron-builder --config electron-builder.config.cjs --win --arm64 --publish never",
    "dist": "electron-builder --config electron-builder.config.cjs --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-native-command": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12"
  }
}
